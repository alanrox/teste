{
  "titulo": "Renda fixa do zero",
  "formato": "horizontal",
  "vozes": ["pm_alex"],
  "falas": [
    {"cena": 0, "fala": "Quatro irmãos receberam dez mil reais cada um, e investiram na renda fixa.", "legendas": ["Quatro irmãos receberam R$ 10 mil cada um, e investiram na renda fixa."]},
    {"cena": 0, "fala": "Três anos depois, um deles tinha mais de treze mil. E outro tinha perdido dinheiro.", "legendas": ["Três anos depois, um deles tinha mais de R$ 13 mil.", "E outro tinha perdido dinheiro."]},
    {"cena": 0, "fala": "Neste vídeo, você vai entender a renda fixa do zero, em quatro capítulos. E, no final, vai saber quem ganhou, e por quê.", "legendas": ["Neste vídeo, você vai entender a renda fixa do zero, em quatro capítulos.", "E, no final, vai saber quem ganhou, e por quê."]},
    {"cena": 1, "fala": "Primeiro, a regra do jogo. Renda fixa é emprestar dinheiro, e receber de volta com juros.", "legendas": ["Primeiro, a regra do jogo.", "Renda fixa é emprestar dinheiro, e receber de volta com juros."]},
    {"cena": 1, "fala": "Os quatro irmãos vão emprestar. O que muda são as escolhas de cada um.", "legendas": ["Os quatro irmãos vão emprestar.", "O que muda são as escolhas de cada um."]},
    {"cena": 2, "fala": "Capítulo um: quem decide o preço do dinheiro?", "legendas": ["Capítulo 1: quem decide o preço do dinheiro?"]},
    {"cena": 2, "fala": "A cada quarenta e cinco dias, o Banco Central define a taxa Selic: os juros básicos do país.", "legendas": ["A cada 45 dias, o Banco Central define a taxa Selic:", "os juros básicos do país."]},
    {"cena": 2, "fala": "Quando ela sobe, emprestar rende mais. Quando cai, rende menos. Neste exemplo, ela está em dez por cento ao ano.", "legendas": ["Quando ela sobe, emprestar rende mais. Quando cai, rende menos.", "Neste exemplo, ela está em 10% ao ano."]},
    {"cena": 3, "fala": "O primeiro irmão achou tudo complicado demais, e deixou os dez mil parados na conta, esperando entender.", "legendas": ["O primeiro irmão achou tudo complicado demais…", "…e deixou os R$ 10 mil parados na conta, esperando entender."]},
    {"cena": 3, "fala": "Dinheiro parado não rende nada. Guarde esse detalhe.", "legendas": ["Dinheiro parado não rende nada.", "Guarde esse detalhe."]},
    {"cena": 4, "fala": "Capítulo dois: como comparar investimentos?", "legendas": ["Capítulo 2: como comparar investimentos?"]},
    {"cena": 4, "fala": "Todo dia, os bancos emprestam dinheiro entre si, a uma taxa colada na Selic: o cê dê i.", "legendas": ["Todo dia, os bancos emprestam dinheiro entre si…", "…a uma taxa colada na Selic: o CDI."]},
    {"cena": 4, "fala": "Por isso, a renda fixa usa o cê dê i como régua. Aqui, cem por cento do cê dê i é dez por cento ao ano.", "legendas": ["Por isso, a renda fixa usa o CDI como régua.", "Aqui, 100% do CDI é 10% ao ano."]},
    {"cena": 5, "fala": "O segundo irmão foi ao banco.", "legendas": ["O segundo irmão foi ao banco."]},
    {"cena": 5, "voz": "pf_dora", "vel": 1.1, "fala": "Temos um cê dê bê que paga cem por cento do cê dê i, com a proteção do fundo garantidor.", "legendas": ["Gerente: “Temos um CDB que paga 100% do CDI…", "…com a proteção do fundo garantidor.”"]},
    {"cena": 5, "fala": "Ele aceitou, e deixou o dinheiro lá por três anos.", "legendas": ["Ele aceitou, e deixou o dinheiro lá por três anos."]},
    {"cena": 6, "fala": "Capítulo três: emprestar para o governo.", "legendas": ["Capítulo 3: emprestar para o governo."]},
    {"cena": 6, "fala": "No Tesouro Direto, você escolhe a regra dos juros.", "legendas": ["No Tesouro Direto, você escolhe a regra dos juros."]},
    {"cena": 6, "fala": "O terceiro irmão travou uma taxa: Tesouro Prefixado, a doze por cento ao ano.", "legendas": ["O terceiro irmão travou uma taxa:", "Tesouro Prefixado, a 12% ao ano."]},
    {"cena": 6, "fala": "O quarto escolheu a inflação, mais um extra: Tesouro i pê cê á mais seis por cento.", "legendas": ["O quarto escolheu a inflação, mais um extra:", "Tesouro IPCA + 6%."]},
    {"cena": 7, "fala": "Capítulo quatro: a mordida do leão.", "legendas": ["Capítulo 4: a mordida do leão."]},
    {"cena": 7, "fala": "Na renda fixa, o imposto de renda diminui com o tempo: vai de vinte e dois e meio por cento, para quem resgata em seis meses, até quinze por cento, depois de dois anos.", "legendas": ["Na renda fixa, o Imposto de Renda diminui com o tempo:", "de 22,5% para quem resgata em 6 meses, até 15% depois de 2 anos."]},
    {"cena": 7, "fala": "Como os irmãos iam ficar três anos, todos pagariam a menor alíquota.", "legendas": ["Como os irmãos iam ficar três anos, todos pagariam a menor alíquota."]},
    {"cena": 8, "pausa": 0.4, "fala": "Mas, seis meses depois, aconteceu uma coisa.", "legendas": ["Mas, seis meses depois, aconteceu uma coisa."]},
    {"cena": 8, "fala": "Os juros do país subiram. E o preço do Tesouro Prefixado caiu no aplicativo.", "legendas": ["Os juros do país subiram.", "E o preço do Tesouro Prefixado caiu no aplicativo."]},
    {"cena": 8, "voz": "pm_santa", "vel": 1.25, "fala": "Tá negativo! Vou vender tudo, antes que piore!", "legendas": ["Irmão 3: “Tá negativo! Vou vender tudo, antes que piore!”"]},
    {"cena": 8, "fala": "O terceiro irmão vendeu no susto, com prejuízo. O quarto também viu o saldo cair, mas segurou até o vencimento.", "legendas": ["O terceiro irmão vendeu no susto, com prejuízo.", "O quarto também viu o saldo cair, mas segurou até o vencimento."]},
    {"cena": 8, "fala": "Isso se chama marcação a mercado: o preço muda no caminho, mas quem espera recebe o combinado.", "legendas": ["Isso se chama marcação a mercado:", "o preço muda no caminho, mas quem espera recebe o combinado."]},
    {"cena": 9, "suspense": 1.4, "fala": "Três anos depois: quem ganhou?", "legendas": ["Três anos depois: quem ganhou?"]},
    {"cena": 9, "fala": "O primeiro ainda tinha dez mil. Mas, com a inflação, eles compravam só o que oito mil e setecentos compravam antes.", "legendas": ["O primeiro ainda tinha R$ 10 mil.", "Mas, com a inflação, eles compravam só o que R$ 8.700 compravam antes."]},
    {"cena": 9, "fala": "O terceiro, que vendeu no susto, ficou com nove mil e novecentos. Se tivesse esperado, teria treze mil e quatrocentos, e ganharia de todos.", "legendas": ["O terceiro, que vendeu no susto, ficou com R$ 9.900.", "Se tivesse esperado, teria R$ 13.400, e ganharia de todos."]},
    {"cena": 9, "fala": "O segundo terminou com doze mil e oitocentos.", "legendas": ["O segundo terminou com R$ 12.800."]},
    {"cena": 9, "fala": "E o quarto, com treze mil e cinquenta: o vencedor.", "legendas": ["E o quarto, com R$ 13.050: o vencedor."]},
    {"cena": 10, "fala": "Na renda fixa, ganha quem entende as regras e respeita o prazo. Perde quem deixa parado, ou vende no susto.", "legendas": ["Na renda fixa, ganha quem entende as regras e respeita o prazo.", "Perde quem deixa parado, ou vende no susto."]},
    {"cena": 10, "fala": "E você, seria qual irmão? Um, dois, três ou quatro? Conta nos comentários.", "legendas": ["E você, seria qual irmão? 1, 2, 3 ou 4?", "Conta nos comentários."]}
  ],
